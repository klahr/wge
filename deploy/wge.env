# Configuration for wge.service.
#
# Every setting here is a `wge serve` flag: WGE_MAX_MACHINES is -max-machines.
# A flag given on the command line wins, so a setting can be overridden for one
# run without editing this file.

# Where players connect. Port 2222 avoids needing a privileged port; to serve
# on 22, either put a proxy in front or give the unit CAP_NET_BIND_SERVICE.
WGE_ADDR=:2222

# State. The database holds the run salts and nothing else that matters --
# back this up and a lost host costs nobody their game.
WGE_DB=/var/lib/wge/wge.db
WGE_HOST_KEY=/var/lib/wge/host_key
WGE_GAMES=/var/lib/wge/games

# Enrolment is closed unless this is true. A server nobody has to be invited to
# is a server anybody can fill; see `wge invite`.
# WGE_OPEN=true

# How many containers this machine will run at once. Empty derives it from the
# memory the Docker engine reports.
# WGE_MAX_MACHINES=

# How long a player's machines outlive their last session, and how often
# abandoned ones are collected.
# WGE_GRACE=15m
# WGE_SWEEP=5m

# Enrolment attempts allowed per address per window. -1 removes the limit.
# WGE_ENROLL_LIMIT=60
# WGE_ENROLL_WINDOW=1h

# The OCI runtime game containers are created with. Empty uses the engine's
# own, which is runc.
#
# gVisor is worth running this under: it puts a reimplemented kernel between a
# player and the host, which is the difference between container escape being
# one kernel bug away and being genuinely hard -- on a machine whose entire
# purpose is to invite strangers to attack it.
#
# It has to be registered with --allow-suid, because gVisor ignores the setuid
# bit by default and su(1) is how a player moves between levels. In
# /etc/docker/daemon.json:
#
#   "runtimes": {
#     "runsc": {
#       "path": "/usr/bin/runsc",
#       "runtimeArgs": ["--allow-suid"]
#     }
#   }
#
# then `systemctl reload docker` -- a reload rather than a restart, so other
# containers on the host are not disturbed. The engine checks this at startup
# and refuses to serve if a setuid binary does not elevate, so a mistake here
# is a service that will not start rather than a game that cannot be played.
# WGE_CONTAINER_RUNTIME=runsc

# Disk. Three different things, because only one of them is a kernel quota.
#
# WGE_MIN_FREE is the room the host keeps back: below it no new run starts.
# This is the one that works on any storage driver, and the one that actually
# keeps the machine alive. Default 5GiB.
# WGE_MIN_FREE=5368709120
#
# WGE_SCRATCH_SIZE is what a run may keep in /srv/scratch before the player is
# told to clear some. It is a measurement and a notice, not a quota: nothing
# portable can stop the write. Default 256MiB.
# WGE_SCRATCH_SIZE=268435456
#
# WGE_STORAGE_SIZE caps a container's own filesystem. It needs a storage driver
# that enforces one -- overlay2 on XFS with pquota, or btrfs. Docker accepts
# the option on drivers that ignore it, so the engine writes past the limit at
# startup and refuses to serve if the write succeeds. Leave it unset unless the
# host really has that driver.
# WGE_STORAGE_SIZE=

# This machine's name in the runs table. Defaults to the hostname. It has to
# survive a restart and mean the same machine afterwards: it is what a run's
# placement is recorded as, and a run goes back to the machine holding its
# scratch space.
# WGE_NODE=
#
# WGE_NODES runs containers on other machines instead of this one, as
# name=endpoint pairs. An endpoint is a unix path or a tcp:// address. Every
# machine listed needs the game images built on it; there is no distribution
# step. Unset means a pool of one, which is this machine.
#
# A name means a machine, not an address: change the endpoint and the runs
# placed there follow it, change the name and they are rescheduled -- which
# costs the players on it their scratch space.
# WGE_NODES=relay=tcp://10.0.0.11:2375,vault=tcp://10.0.0.12:2375
#
# WGE_NODE and WGE_NODES are alternatives. Setting both is refused: one of them
# would be ignored, and which one is not obvious from the file.
#
# A tcp:// engine endpoint is root on that machine to anyone who can reach the
# port. Docker's own TLS is not spoken here, so put the pool on a network only
# the engine is on -- a private segment, a WireGuard link, an SSH tunnel -- and
# do not bind a daemon to a public address.
