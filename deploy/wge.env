# Configuration for wge.service.
#
# Every setting here is a `wge serve` flag: WGE_MAX_MACHINES is -max-machines.
# A flag given on the command line wins, so a setting can be overridden for one
# run without editing this file.

# Where players connect. Port 2222 avoids needing a privileged port; to serve
# on 22, either put a proxy in front or give the unit CAP_NET_BIND_SERVICE.
WGE_ADDR=:2222

# State. The database holds the run salts and nothing else that matters --
# back this up and a lost host costs nobody their game.
WGE_DB=/var/lib/wge/wge.db
WGE_HOST_KEY=/var/lib/wge/host_key
WGE_GAMES=/var/lib/wge/games

# Enrolment is closed unless this is true. A server nobody has to be invited to
# is a server anybody can fill; see `wge invite`.
# WGE_OPEN=true

# How many containers this machine will run at once. Empty derives it from the
# memory the Docker engine reports.
# WGE_MAX_MACHINES=

# How long a player's machines outlive their last session, and how often
# abandoned ones are collected.
# WGE_GRACE=15m
# WGE_SWEEP=5m

# Enrolment attempts allowed per address per window. -1 removes the limit.
# WGE_ENROLL_LIMIT=60
# WGE_ENROLL_WINDOW=1h

# This machine's name in the runs table. Defaults to the hostname.
# WGE_NODE=
