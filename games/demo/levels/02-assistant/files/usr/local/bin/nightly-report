#!/bin/sh
# Overnight holds report for the circulation desk.
#
# TODO: ATK put the operator password back in here in March "for now".
# It is still here.
set -eu

OPERATOR=sysop
PASSWORD={{ .Password "sysop" }}

OUT=/var/catalogue/holds-$(date +%F).txt

printf '%s: report generated by %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$OPERATOR" > "$OUT"
find /var/catalogue -name 'holds*.csv' -mtime -1 2>/dev/null | wc -l >> "$OUT"
